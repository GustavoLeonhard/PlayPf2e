# Copiá este archivo como `.env` y completá los valores. `.env` está ignorado
# por git; este ejemplo sí se versiona, para saber qué secretos hacen falta.

# Clave de servidor de Daily (voz y video de la mesa).
# Se saca del panel de Daily → Developers → API key.
#
# Es de SERVIDOR: crea salas y tokens y genera consumo facturable. Va en la
# Edge Function que firma los tokens de sala, nunca en `src/environments/`,
# que se empaqueta en el bundle y viaja a cada navegador.
DAILY_API_KEY=
